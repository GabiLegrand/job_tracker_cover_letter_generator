# OpenRouter — get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Any model name exposed by OpenRouter; swap freely.
OPENROUTER_MODEL=minimax/minimax-m3

# Used in OpenRouter HTTP-Referer / X-Title headers and for CORS allow-list.
APP_URL=http://localhost:5173
APP_TITLE=Cover Letter Generator

CV_DATA_PATH=/path/to/data
WORK_EXPERIENCE_JSONFILE=work_experience.json

LETTER_POSTGRES_USER=coverletter
LETTER_POSTGRES_PASSWORD=coverletter
LETTER_POSTGRES_DB=coverletter

API_COVER_PUBLIC_PORT=8000
COVER_FE_PUBLIC_PORT=5173
COVER_PG_PUBLIC_PORT=5432
